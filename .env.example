# Copiar a .env y ajustar. Todos tienen valor por defecto en docker-compose.yml
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders
POSTGRES_DB=orders
POSTGRES_PORT=5432

# Pool de conexiones de la API (chico a propósito para que se note el agotamiento)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5

# Token para /admin/faults
ADMIN_TOKEN=change-me

# Puertos publicados en el host
HTTPS_PORT=8443
HTTP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Generador de carga (perfil "load")
LOADGEN_RPS=20
LOADGEN_CONCURRENCY=10
